PORT=8000
ORIENTEERING_PORTAL_DB_PATH=/data/orienteering/orienteering.sqlite3
ORIENTEERING_PORTAL_UPLOAD_DIR=/data/orienteering/uploads
ORIENTEERING_PORTAL_MAP_DIR=/data/orienteering/maps

# Optional: username that is logged in automatically when no cookie is set.
# Leave empty to require login through the UI.
ORIENTEERING_PORTAL_AUTO_LOGIN=

# Claude Code is installed in the production Docker image.
# Its auth files are expected under HOME/.claude.
HOME=/data/orienteering
CLAUDE_CLI_PATH=/usr/local/bin/claude
ANTHROPIC_API_KEY=
